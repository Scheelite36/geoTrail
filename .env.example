# 复制本文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传到仓库；
# docker compose 会自动读取同目录下的 .env 注入到容器。

# PostGIS / Neo4j 本地 Demo 默认口令（可按需修改）
POSTGRES_PASSWORD=geo123
NEO4J_PASSWORD=geo12345

# 火山方舟（Volcengine Ark）OpenAI 兼容接口的 API Key
# 获取方式：https://console.volcengine.com/ark ，切勿把真实 Key 提交到仓库
AGENT_LLM_API_KEY=your-volcengine-ark-api-key-here
